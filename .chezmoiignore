# Repository files, not home-directory targets.
.git
.gitignore
.stow-local-ignore
deploy.sh
main.py

# Generated or machine-local opencode state.
.config/opencode/local-config.json
.config/opencode/node_modules
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/bun.lock

# Generated or sensitive Pi agent state.
.pi/agent/auth.json
.pi/agent/trust.json
.pi/agent/sessions
.pi/agent/npm
.pi/agent/git
.pi/agent/pi-debug.log

# Headless coding services run only on designated hosts.
{{ if not (eq .chezmoi.hostname "scotty") }}
.config/systemd/user/cli-secrets.env
.config/systemd/user/opencode.service
.config/systemd/user/t3code.service
.local/lib/t3code
{{ end }}
