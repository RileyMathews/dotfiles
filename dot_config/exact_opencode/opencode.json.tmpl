{{- $hostname := output "hostname" | trim -}}
{
  "$schema": "https://opencode.ai/config.json",
  "snapshots": false,
  "default_agent": "build",
  "disabled_providers": [
    "github-models",
    "github-copilot-enterprise",
    "amazon-bedrock",
    "github-copilot"{{ if eq $hostname "picard" }},{{ end }}
    {{- if eq $hostname "picard" }}
    "opencode"
    {{- end }}
  ],
  "mcp": {
    "servers": {
    {{- if eq $hostname "picard" }}
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "honeycomb": {
      "type": "remote",
      "url": "https://mcp.honeycomb.io/mcp",
      "oauth": {}
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    }
    {{- end }}
    }
  },
  "providers": {
    {{- if eq $hostname "ds9" }}
    "opencode": {
      "models": {
        "gpt-5.5": { "disabled": true },
        "gpt-5.5-pro": { "disabled": true },
        "gpt-5.4": { "disabled": true },
        "gpt-5.4-pro": { "disabled": true },
        "gpt-5.4-mini": { "disabled": true },
        "gpt-5.4-nano": { "disabled": true },
        "gpt-5.3-codex-spark": { "disabled": true },
        "gpt-5.3-codex": { "disabled": true },
        "gpt-5.2": { "disabled": true },
        "gpt-5.2-codex": { "disabled": true },
        "gpt-5.1": { "disabled": true },
        "gpt-5.1-codex-max": { "disabled": true },
        "gpt-5.1-codex": { "disabled": true },
        "gpt-5.1-codex-mini": { "disabled": true },
        "gpt-5": { "disabled": true },
        "gpt-5-codex": { "disabled": true },
        "gpt-5-nano": { "disabled": true }
      }
    }
    {{- end }}
    {{- if eq $hostname "picard" }}
    "litellm": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "kosmic",
      "settings": {
        "baseURL": "https://ai.kosmic.internal/v1"
      },
      "models": {
        "minimax-m2.5": {
          "name": "Minimax m2.5"
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "openai/gpt-5.5-pro": {
          "name": "GPT 5.5 Pro"
        }
      }
    }
    {{- end }}
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "make *", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ]
}
