#!/usr/bin/env bash
set -euo pipefail

models_dir="$HOME/code/glTF-Sample-Assets/Models"
filament_dir="$HOME/code/filament"
viewer="./out/release/filament/bin/gltf_viewer"

if ! command -v fzf >/dev/null 2>&1; then
  printf 'gltf-sample-viewer: fzf is required\n' >&2
  exit 1
fi

if [[ ! -d "$models_dir" ]]; then
  printf 'gltf-sample-viewer: models directory not found: %s\n' "$models_dir" >&2
  exit 1
fi

if [[ ! -x "$filament_dir/${viewer#./}" ]]; then
  printf 'gltf-sample-viewer: viewer not found or not executable: %s\n' \
    "$filament_dir/${viewer#./}" >&2
  exit 1
fi

selection=$(
  for model_dir in "$models_dir"/*; do
    [[ -d "$model_dir" ]] || continue
    model_name=${model_dir##*/}
    [[ -f "$model_dir/glTF-Binary/$model_name.glb" ]] || continue
    printf '%s\n' "$model_name"
  done | fzf --prompt='glTF model> ' --height=80% --border
) || exit_code=$?

exit_code=${exit_code:-0}
if [[ $exit_code -ne 0 || -z "$selection" ]]; then
  exit 0
fi

model="$models_dir/$selection/glTF-Binary/$selection.glb"

cd "$filament_dir"
exec "$viewer" "$model"
