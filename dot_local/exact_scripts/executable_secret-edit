#!/usr/bin/env bash
set -euo pipefail

# Override this when the source is checked out somewhere other than ~/code/dotfiles.
source_dir="${CHEZMOI_SOURCE_DIR:-$HOME/code/dotfiles}"
encrypted_file="${1:-$source_dir/dot_config/exact_zsh/encrypted_secrets.zsh}"

exec chezmoi --source "$source_dir" edit-encrypted "$encrypted_file"
